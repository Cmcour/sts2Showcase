---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="sts2Player" activeTab="about">
  <main class="frame">
    <div class="park-header">
      <div>
        <div class="region">⟢ trail guide · region 1 ⟣</div>
        <h1>Coaching an AI Through Slay the Spire 2</h1>
      </div>
      <svg class="emblem compass" viewBox="0 0 80 80" aria-hidden="true">
        <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="40" cy="40" r="28" fill="none" stroke="currentColor" stroke-width=".8" stroke-dasharray="2 3"/>
        <path d="M 40 12 L 46 40 L 40 36 L 34 40 Z" fill="var(--rust)"/>
        <path d="M 40 68 L 46 40 L 40 44 L 34 40 Z" fill="currentColor" opacity=".5"/>
        <text x="40" y="9" text-anchor="middle" font-family="Playfair Display,serif" font-size="9" font-weight="700" fill="currentColor">N</text>
        <text x="40" y="78" text-anchor="middle" font-family="Playfair Display,serif" font-size="9" font-weight="700" fill="currentColor">S</text>
      </svg>
    </div>

    <div class="intro-grid">
      <div class="intro-block">
        <p><span class="intro-mark">What:</span> Reinforcement learning applied to Slay the Spire 2: train a bot to play, then surface optimal strategy from its policy.</p>
      </div>
      <div class="intro-block">
        <p><span class="intro-mark">Why:</span> A personal-project sandbox to learn data and ML principles through practice.</p>
      </div>
    </div>

    <svg class="map-canvas" viewBox="0 0 1000 380" aria-hidden="true">
      <path d="M 50 350 Q 60 340, 70 330 C 92 315, 158 243, 200 240 C 242 237, 280 293, 320 310 C 360 328, 398 352, 440 345 C 482 338, 527 279, 570 270 C 613 261, 657 298, 700 290 C 743 282, 788 243, 830 220 C 872 197, 930 162, 950 150 L 950 360 L 50 360 Z" fill="var(--moss)" opacity=".15"/>
      <path d="M 100 80 Q 200 30, 320 60 Q 360 70, 380 50 Q 400 30, 460 50 Q 500 60, 540 40 Q 580 20, 660 40 Q 720 50, 760 30 L 760 100 L 100 100 Z" fill="var(--lake)" opacity=".18"/>
      <text x="220" y="90" font-family="Playfair Display,serif" font-style="italic" font-size="13" fill="var(--lake)">~ uncharted models ahead ~</text>
      <path d="M 70 290 C 92 275, 158 203, 200 200 C 242 197, 280 253, 320 270 C 360 288, 398 312, 440 305 C 482 298, 527 239, 570 230 C 613 221, 657 258, 700 250 C 743 242, 788 203, 830 180 C 872 157, 930 122, 950 110" stroke="var(--rust)" stroke-width="3" fill="none" stroke-dasharray="6 8" stroke-linecap="round"/>
      <g font-family="Avenir,sans-serif" font-size="11" fill="var(--ink)">
        <g transform="translate(70 290)"><circle r="13" fill="var(--rust)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" fill="var(--paper)" font-weight="700" font-size="11">1</text><text y="-22" text-anchor="middle" font-weight="700">Foundation Camp</text><text y="32" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Fighting</text></g>
        <g transform="translate(200 200)"><circle r="13" fill="var(--rust)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" fill="var(--paper)" font-weight="700" font-size="11">2</text><text y="-22" text-anchor="middle" font-weight="700">Cards Cliff</text><text y="32" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Card-picking</text></g>
        <g transform="translate(320 270)"><circle r="13" fill="var(--rust)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" fill="var(--paper)" font-weight="700" font-size="11">3</text><text y="-22" text-anchor="middle" font-weight="700">Rest Glen</text><text y="32" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Rest-site</text></g>
        <g transform="translate(440 305)"><circle r="14" fill="var(--rust)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" fill="var(--paper)" font-weight="700" font-size="12">4</text><text y="-22" text-anchor="middle" font-weight="700">Shop Hollow</text><text y="34" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Shop choices</text><text y="-36" text-anchor="middle" font-size="9" fill="var(--rust)" font-weight="700">YOU ARE HERE ▾</text></g>
        <g transform="translate(570 230)"><circle r="11" fill="var(--paper)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" font-weight="700" font-size="11">5</text><text y="-20" text-anchor="middle" font-weight="700">Relic Ridge</text><text y="30" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Boss relics</text></g>
        <g transform="translate(700 250)"><circle r="11" fill="var(--paper)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" font-weight="700" font-size="11">6</text><text y="-20" text-anchor="middle" font-weight="700">Event Pass</text><text y="30" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Events</text></g>
        <g transform="translate(830 180)"><circle r="11" fill="var(--paper)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" font-weight="700" font-size="11">7</text><text y="-20" text-anchor="middle" font-weight="700">Map Mesa</text><text y="30" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Pathing</text></g>
        <g transform="translate(950 110)"><circle r="14" fill="var(--sun)" stroke="var(--ink)" stroke-width="2"/><text y="4" text-anchor="middle" font-weight="700" font-size="12">8</text><text y="-22" text-anchor="middle" font-weight="700">Spire Summit</text><text y="34" text-anchor="middle" font-style="italic" fill="var(--ink-soft)">Acts 2/3</text></g>
      </g>
      <path d="M 200 187 Q 260 165, 320 257" stroke="var(--rust)" stroke-width="1.5" stroke-dasharray="2 3" fill="none"/>
      <text x="260" y="155" font-family="Avenir,sans-serif" font-size="10" fill="var(--rust)" font-style="italic" text-anchor="middle">co-train route</text>
      <g transform="translate(810 340)">
        <line x1="0" y1="0" x2="100" y2="0" stroke="var(--ink)" stroke-width="1.5"/>
        <line x1="0" y1="-3" x2="0" y2="3" stroke="var(--ink)" stroke-width="1.5"/>
        <line x1="50" y1="-3" x2="50" y2="3" stroke="var(--ink)" stroke-width="1.5"/>
        <line x1="100" y1="-3" x2="100" y2="3" stroke="var(--ink)" stroke-width="1.5"/>
        <text x="50" y="14" text-anchor="middle" font-family="Avenir,sans-serif" font-size="9" fill="var(--ink-soft)">~ training time ~</text>
      </g>
    </svg>

    <div class="legend-strip">
      <div><strong>━ ━ trail</strong>training order</div>
      <div><strong>● solid</strong>built so far</div>
      <div><strong>▾ flag</strong>current focus</div>
      <div><strong>○ open</strong>not yet started</div>
    </div>

    <div class="stats-strip">
      <div class="tile">
        <svg class="tile-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M 24 6 L 38 14 L 38 30 L 24 38 L 10 30 L 10 14 Z" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="24" cy="22" r="4" fill="currentColor"/></svg>
        <div><div class="tile-num">4 / 8</div><div class="tile-lbl">stops on the trail</div><div class="tile-delta">Shop Hollow — current focus</div></div>
      </div>
      <div class="tile">
        <svg class="tile-icon" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="2" fill="none"/><path d="M 24 16 L 24 24 L 30 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
        <div><div class="tile-num">250k+</div><div class="tile-lbl">Runs simulated</div><div class="tile-delta">Full game playthroughs across the Phase 3 fleet</div></div>
      </div>
    </div>

    <div class="updates">
      <div class="callout"><div class="callout-label">⟢ today's bearings</div><p>I'm running 11 worker laptops simulating about 9 full game runs per minute, with three learners on the brain box: combat (stable, in maintenance mode), the picker+rest fused RunStateModel still actively training on Phase 3, and the new ShopModel that just came online. The shop pipeline took a five-iteration mod fix to wire correctly — Phase3Bridge.SendEndOfRun now blocks synchronously so the end_of_run notification can't race the game-over teardown. ShopModel is firing PPO updates every couple minutes, V-head shows positive correlation with boss-win, and the action mix is spread across all 10 slots (no collapse to "leave shop").</p></div>
      <div class="callout next"><div class="callout-label">→ next leg</div><p>The next decision is whether to escalate the ShopModel away from chronic-low V-variance — Option E bumps records-per-update from 32 to 64 to cut gradient noise, Option F pauses the picker for a 200-update bootstrap window where shop borrows the picker's V-head as an auxiliary anchor. I want to give the standard A-option another 50 updates to see if V settles before pulling the escalation lever. After shop is stable, EventModel is next — gold-yielding event branches only become learnable once shop policy is non-random.</p></div>
    </div>

    <div class="scenic">
      <div class="scenic-stop"><span class="scenic-num">1</span><h2>The Expedition <span class="scenic-sub">(the project)</span></h2><p>Train an AI that can climb Slay the Spire 2 at a competitive level — and along the way, let its policy chart the optimal routes humans don't have clear answers to. The summit: a system that reaches the top consistently and leaves a map I can learn from.</p></div>
      <div class="scenic-stop"><span class="scenic-num">2</span><h2>The Mountain <span class="scenic-sub">(the game)</span></h2><p>A roguelike deck-building game. You climb sixteen floors per act, fighting enemies card-by-card and adding one new card to your deck after each combat. Rest sites, shops, and events branch off the path between fights. Decisions compound — one bad card pick early can cascade into a failed run thirty minutes later. High skill ceiling, active competitive community.</p></div>
      <div class="scenic-stop"><span class="scenic-num">3</span><h2>The Knot <span class="scenic-sub">(the challenge)</span></h2><p>Building a competitive Slay the Spire 2 AI means solving seven interdependent decision problems: combat, card picks, rest sites, shops, events, relics, and routing. Naive sequential training fails — a shop policy can't learn whether a card is worth 75 gold without a picker that already evaluates decks containing it, and the picker can't see late-act states without routing to get there. Train any one in isolation and you optimize against a stale version of every other.</p></div>
      <div class="scenic-stop"><span class="scenic-num">4</span><h2>The Route <span class="scenic-sub">(the approach)</span></h2><p>A documented attempt to teach an AI to play Slay the Spire 2 at a competitive level. Seven specialized reinforcement-learning models, one per decision surface a human navigates in a run, trained one at a time. Combat trains first as the foundation; every later model inherits its vocabulary of cards, relics, and enemies (frozen embedding warm-start) and trains its own encoder and heads on top. Eleven worker laptops generate the games; one central machine runs the PPO learners.</p></div>
      <div class="scenic-stop"><span class="scenic-num">5</span><h2>Why I'm Climbing <span class="scenic-sub">(the motivation)</span></h2><p>It started during two weeks of PTO that I wanted to spend on a real side project — specifically, neural networks, the most fascinating mathematics I've come across. About 120 hours over those two weeks (coding, prompting, setup, documenting, research) got the framework standing and the first model training. I learn by doing. This project gives me a sandbox across the full stack of an ML system — data analysis, frontend, data storage, distributed infrastructure — that I can push into whenever I'm ready. Right now my focus is entirely on the machine learning side. The choice of Slay the Spire 2 is honest: I love the game, most of its decisions don't have an obvious right answer, and I wanted to use RL to find out what the right answer actually is.</p></div>
      <div class="scenic-stop"><span class="scenic-num">6</span><h2>Field Notes <span class="scenic-sub">(the site)</span></h2><p>AI agents do most of the work here: they propose topics, draft the articles, design the layouts, write the research papers, and build the quizzes. My job is to review their output at every stage and to study each paper until I know the topic at an industry level — not just at the level of my own codebase. Articles don't publish until I pass the quiz on the paper, so I'm not shipping anything I can't defend.</p></div>
    </div>
  </main>
</Base>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    margin: 0 0 32px;
    padding-bottom: 24px;
    border-bottom: 1px dashed var(--ink-soft);
  }
  .intro-block { position: relative; }
  .intro-block:first-child::after {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    right: -32px;
    border-left: 1px dashed var(--ink-soft);
  }
  .intro-block p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink);
  }
  .intro-block p + p { margin-top: 12px; }
  .intro-mark {
    font-family: var(--serif);
    font-weight: 700;
    color: var(--rust);
    font-size: 1.125rem;
    letter-spacing: 0.02em;
    margin-right: 6px;
  }
  @media (max-width: 880px) {
    .intro-grid { grid-template-columns: 1fr; gap: 20px; }
    .intro-block:first-child::after { display: none; }
  }
  .map-canvas {
    margin: 0 auto 24px;
    width: 100%;
    display: block;
    background: var(--paper-2);
    background-image: radial-gradient(circle, rgba(31, 44, 32, 0.08) 1px, transparent 1.2px);
    background-size: 18px 18px;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    padding: 10px;
  }
  .legend-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 0 0 28px;
    padding: 14px 16px;
    background: var(--paper-2);
    border: 1px dashed var(--ink-soft);
    border-radius: 4px;
    font-size: 0.71875rem;
    color: var(--ink-soft);
  }
  .legend-strip strong {
    color: var(--ink);
    display: block;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }
  .stats-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }
  .updates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }
  .updates .callout { margin: 0; }
  .scenic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 8px;
  }
  .scenic-stop {
    padding: 18px 0;
    border-top: 1px solid var(--ink-soft);
  }
  .scenic-num {
    display: inline-block;
    width: 32px; height: 32px; line-height: 32px;
    text-align: center;
    background: var(--rust);
    color: var(--paper);
    font-family: var(--serif);
    font-weight: 700;
    border-radius: 50%;
    font-size: 1rem;
    margin-right: 10px;
    vertical-align: middle;
  }
  .scenic-stop h2 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    display: inline;
    letter-spacing: -0.005em;
  }
  .scenic-stop p {
    margin-top: 10px;
    font-size: 0.90625rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .scenic-sub {
    font-family: var(--sans, Avenir, sans-serif);
    font-size: 0.75rem;
    font-weight: 400;
    font-style: italic;
    color: var(--ink-soft);
    letter-spacing: 0;
    margin-left: 6px;
    text-transform: lowercase;
  }
  @media (max-width: 880px) {
    .stats-strip, .updates, .scenic { grid-template-columns: 1fr; }
    .legend-strip { grid-template-columns: 1fr 1fr; }
  }
</style>
