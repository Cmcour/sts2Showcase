---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;

type Post = {
  slug: string;
  title: string;
  date: string;
  category: string;
  excerpt: string;
};
const posts: Post[] = [
  {
    slug: 'patching-closed-source-game-with-harmony',
    title: 'Patching a Closed-Source Game with Harmony',
    date: 'April 2026',
    category: 'Deep Dive',
    excerpt: 'Slay the Spire 2 is closed-source. The first decision wasn’t about networks or PPO — it was whether an environment could exist at all. Why Harmony as primary and Cecil as fallback, the Finalizer-pattern saga that survived a beta .tscn update, and the principle that compounded into every subsequent layer of the project.',
  },
];
---
<Base title="Deep Dives" activeTab="deep-dive">
  <main class="frame">
    <div class="index-head">
      <h1>Deep Dives</h1>
      <p class="sub">Technical deep dives into specific components of the system.</p>
    </div>

    <ul class="post-list">
      {posts.map(post => (
        <li class="post-item">
          <a href={`${base}deep-dive/${post.slug}/`}>
            <div class="post-kicker">{post.category}</div>
            <div class="post-top">
              <div class="post-title">{post.title}</div>
              <span class="post-date">{post.date}</span>
            </div>
            <p class="post-lede">{post.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<!-- _v5 Workshop Warm blog index — amber kicker, bold title, dim lede, mono date right. 2026-04-18_ -->
