            <tr><td class="lane">Commit messages</td><td>comms-relay</td><td class="empty-cell"></td></tr>
            <tr><td class="lane">Research notes</td><td>recon-runner</td><td class="empty-cell"></td></tr>
          </tbody>
        </table>
      </div>
      <div class="empty-arrow" aria-hidden="true">
        <svg viewBox="0 0 32 14" fill="none">
          <path d="M 2 7 Q 12 1, 22 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M 18 3 L 22 7 L 18 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
