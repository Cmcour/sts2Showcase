---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;

type Post = {
  slug: string;
  title: string;
  date: string;
  category: string;
  excerpt: string;
};
const posts: Post[] = [];
---
<Base title="Agent Workflow" activeTab="agent-workflow">
  <main class="frame">
    <div class="index-head">
      <h1>Agent Workflow</h1>
      <p class="sub">How I set up Claude Code, Codex, subagents, skills, hooks, and the rest of my AI coding stack.</p>
    </div>

    <ul class="post-list">
      {posts.map(post => (
        <li class="post-item">
          <a href={`${base}agent-workflow/${post.slug}/`}>
            <div class="post-kicker">{post.category}</div>
            <div class="post-top">
              <div class="post-title">{post.title}</div>
              <span class="post-date">{post.date}</span>
            </div>
            <p class="post-lede">{post.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
