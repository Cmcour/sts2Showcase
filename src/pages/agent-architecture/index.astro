---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;

type Post = {
  slug: string;
  title: string;
  date: string;
  category: string;
  badge?: string;
  reading?: string;
  spec: string;
  detail?: string;
};
const posts: Post[] = [
  {
    slug: 'sts2player-subagent-crew',
    title: 'The Subagent Crew Inside sts2Player',
    date: 'May 2026',
    category: 'Agent Architecture',
    badge: 'field equipment 2',
    reading: '~22 min hike',
    spec: 'Nine specialists, five lanes, one orchestrator. A tour of the .claude/agents/ crew that keeps a 100+-file RL stack from cross-contaminating itself — who they are, why each one got carved out, the hard rules, and the war stories that sharpened them.',
    detail: '9 specialists · 5 lanes · 36 hr buildout',
  },
];
---
<Base title="Agent Architecture" activeTab="agent-architecture">
  <main class="frame">
    <div class="park-header">
      <div>
        <div class="region">⟢ field equipment · what's in the pack ⟣</div>
        <h1>Agent Architecture</h1>
      </div>
      <svg class="emblem" viewBox="0 0 88 88" aria-hidden="true" style="color: var(--lake)">
        <path d="M 22 18 L 22 14 Q 22 10, 26 10 L 36 10 Q 40 10, 40 14 L 40 18" stroke="currentColor" stroke-width="2" fill="none"/>
        <path d="M 18 18 L 70 18 Q 74 18, 74 22 L 74 70 Q 74 78, 66 78 L 22 78 Q 14 78, 14 70 L 14 22 Q 14 18, 18 18 Z" stroke="currentColor" stroke-width="2" fill="none"/>
        <rect x="22" y="32" width="44" height="14" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <rect x="26" y="52" width="18" height="20" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <rect x="48" y="52" width="18" height="20" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <line x1="14" y1="40" x2="8" y2="44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="74" y1="40" x2="80" y2="44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
    <p class="description">The agent setup that actually built and maintains this site. Real config, real prompts, real failures — not the marketing version. Each entry is a piece of the kit you could lift into your own setup.</p>

    {posts.length === 0 ? (
      <div class="empty-pack">
        <svg viewBox="0 0 42 42" aria-hidden="true"><circle cx="21" cy="21" r="14" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="4 3"/><circle cx="21" cy="21" r="3" fill="currentColor"/></svg>
        <p>Pack is empty — the first piece of equipment lands once the first Agent-Architecture article ships. The subagent-crew article is currently in draft.</p>
      </div>
    ) : (
      <div class="gear-list">
        {posts.map(post => (
          <a class="gear-item" href={`${base}agent-architecture/${post.slug}/`}>
            <div class="gear-icon">
              <svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="22" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="28" cy="28" r="3" fill="currentColor"/></svg>
            </div>
            <div>
              <div class="gear-meta">
                {post.badge && <span class="badge">{post.badge}</span>}
                {post.reading && <span>{post.reading}</span>}
              </div>
              <h2>{post.title}</h2>
              <p class="gear-spec">{post.spec}</p>
              {post.detail && <div class="gear-detail">{post.detail}</div>}
            </div>
          </a>
        ))}
      </div>
    )}

    <p class="footer-note">⟢ pack updates as new gear is added; oldest entries stay legible at the bottom ⟣</p>
  </main>
</Base>

<style>
  .gear-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 8px; }
  .gear-item {
    background: var(--paper-2);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    padding: 24px 26px;
    color: inherit;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 18px;
    align-items: start;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .gear-item:hover { transform: translateY(-2px); box-shadow: 0 8px 0 var(--ink); text-decoration: none; }
  .gear-icon { display: flex; align-items: flex-start; justify-content: center; color: var(--rust); }
  .gear-icon svg { width: 56px; height: 56px; }
  .gear-meta {
    display: flex; gap: 10px;
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .gear-meta .badge { color: var(--lake); }
  .gear-item h2 {
    font-family: var(--serif);
    font-size: 1.3125rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  .gear-spec { font-size: 0.875rem; line-height: 1.55; color: var(--ink); margin-bottom: 8px; }
  .gear-detail { font-size: 0.71875rem; color: var(--ink-soft); font-style: italic; }
  .gear-detail::before { content: "specs · "; }
  .empty-pack {
    margin: 32px 0 8px;
    padding: 28px;
    text-align: center;
    background: var(--paper-2);
    border: 1px dashed var(--ink-soft);
    border-radius: 4px;
  }
  .empty-pack svg { color: var(--ink-soft); width: 42px; height: 42px; margin-bottom: 12px; }
  .empty-pack p { font-style: italic; color: var(--ink-soft); font-size: 0.90625rem; max-width: 520px; margin: 0 auto; }
  @media (max-width: 780px) {
    .gear-list { grid-template-columns: 1fr; }
    .gear-item { grid-template-columns: 48px 1fr; padding: 20px 22px; gap: 14px; }
    .gear-icon svg { width: 42px; height: 42px; }
  }
</style>
