<Post
  title="The Subagent Crew Inside sts2Player"
  date="May 2026"
  activeTab="agent-architecture"
  category="Agent Architecture"
  readingTime="~22 min hike"
  headings={headings}
  stopNumber="2"
  stopTag="Agents"
